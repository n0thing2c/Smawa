        "format": "<template>\n<div class=\"ir\">\n\n<div class=\"card\"><div class=\"headrow\"><h2>🌱 &nbsp;Biểu đồ độ ẩm đất theo thời gian (ThingSpeak)</h2>\n<div class=\"periods\"><button class=\"btn\" :class=\"period==='24h'?'':'outline'\" @click=\"period='24h'\">24 giờ</button><button class=\"btn\" :class=\"period==='7d'?'':'outline'\" @click=\"period='7d'\">7 ngày</button><button class=\"btn\" :class=\"period==='custom'?'':'outline'\" @click=\"period='custom'\">Tùy chọn</button></div></div>\n<div v-if=\"period==='custom'\" style=\"display:flex;gap:12px;align-items:end;flex-wrap:wrap;margin-top:12px\">\n<div class=\"field\" style=\"margin:0\"><label>Từ ngày</label><input type=\"date\" v-model=\"fromDate\" /></div><div class=\"field\" style=\"margin:0\"><label>Đến ngày</label><input type=\"date\" v-model=\"toDate\" /></div></div>\n<svg class=\"chartframe\" viewBox=\"0 0 960 330\" role=\"img\" aria-label=\"Biểu đồ đường độ ẩm đất mô phỏng\">\n<g v-for=\"v in [0,20,40,60,80,100]\" :key=\"v\"><line x1=\"58\" :y1=\"285-v*2.3\" x2=\"934\" :y2=\"285-v*2.3\" stroke=\"#d9e1e8\" stroke-width=\"1\"/><text x=\"44\" :y=\"290-v*2.3\" text-anchor=\"end\" font-size=\"15\" fill=\"#5c6c77\">{{v}}</text></g>\n<path :d=\"areaPath\" fill=\"#18a8af\" fill-opacity=\"0.13\" />\n<polyline :points=\"linePoints\" fill=\"none\" stroke=\"#078c97\" stroke-width=\"4\" stroke-linejoin=\"round\" />\n<circle v-for=\"(d,i) in values\" :key=\"i\" :cx=\"xpos(i)\" :cy=\"ypos(d)\" r=\"4\" fill=\"white\" stroke=\"#078c97\" stroke-width=\"3\" />\n<text x=\"15\" y=\"160\" fill=\"#536575\" font-size=\"15\" transform=\"rotate(-90 15 160)\">Độ ẩm đất (%)</text></svg>\n<div class=\"chart-labels\"><span v-for=\"l in ticks\" :key=\"l\">{{l}}</span></div>\n<div class=\"note\">Khoảng thời gian: <b>{{ periodLabel }}</b> &nbsp;|&nbsp; Giá trị cuối: <b>{{ values[values.length-1] }}%</b></div>\n\n</div>\n</template>\n<script>\nexport default {\n  data(){return {period:'24h',fromDate:'',toDate:'',v24:[65,63,60,57,54,52,49,46,48,73,70,68,65,62,59,57,54,52],v7:[44,49,40,61,70,56,62,58,45,49,54,66,51,57]}},\n  computed:{\n    values(){return this.period==='7d'?this.v7:this.period==='custom'?this.v24.slice(3,15):this.v24},\n    linePoints(){return this.values.map((v,i)=>this.xpos(i)+','+this.ypos(v)).join(' ')},\n    areaPath(){let p=this.linePoints.split(' ');return 'M '+p[0]+' L '+p.slice(1).join(' L ')+' L '+this.xpos(this.values.length-1)+',285 L 58,285 Z'},\n    periodLabel(){return this.period==='24h'?'24 giờ qua':this.period==='7d'?'7 ngày qua':(this.fromDate&&this.toDate?this.fromDate+' – '+this.toDate:'Tùy chọn (demo)')},\n    ticks(){return this.period==='7d'?['7 ngày trước','6 ngày','5 ngày','4 ngày','3 ngày','2 ngày','Hôm nay']:this.period==='custom'?['Bắt đầu','Giữa khoảng','Kết thúc']:['00:00','04:00','08:00','12:00','16:00','20:00','24:00']}\n  },\n  methods:{xpos(i){return 58+(876*i/Math.max(1,this.values.length-1))},ypos(v){return 285-v*2.3}}\n}\n</script>\n<style>\n\n.ir{font-family:Roboto,Arial,sans-serif;color:#16232d;max-width:1450px;margin:0 auto;padding:12px 8px 30px}\n.ir *{box-sizing:border-box}.ir h1{font-size:30px;font-weight:800;margin:4px 0 22px}.ir h2{font-size:20px;font-weight:750;margin:0 0 18px}.ir h3{font-size:17px;font-weight:700;margin:0 0 15px}\n.ir .muted{color:#6b7e8e}.ir .card{background:white;border:1px solid #e2e9ef;box-shadow:0 3px 12px #18364c14;border-radius:14px;padding:23px;min-width:0}\n.ir .btn{appearance:none;border:0;background:#00868e;color:white;font-size:16px;font-weight:700;border-radius:9px;padding:13px 23px;cursor:pointer;text-align:center}.ir .btn:hover{background:#006b75}.ir .btn:focus-visible{outline:3px solid #6acbd0;outline-offset:2px}\n.ir .outline{background:white;border:1px solid #cbd7df;color:#1d4856}.ir .outline.active{background:#00868e;color:white}\n.ir .note{padding:14px 17px;background:#e4f1ff;color:#1a5886;border-radius:9px;font-size:14px;margin-top:18px}\n.ir .headrow{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}\n.ir input[type=text], .ir input[type=password], .ir input[type=number], .ir input[type=date]{font:inherit;display:block;border:1px solid #becdd9;border-radius:9px;background:white;padding:11px 12px;min-width:0;width:100%;color:#172936}\n.ir label{font-weight:650}.ir .field{display:grid;gap:7px;margin:0 0 18px}.ir .auth{max-width:530px;margin:35px auto 10px;padding:35px 38px}.ir .auth h1{text-align:center;margin-top:12px}.ir .auth-mark{text-align:center;font-size:42px}.ir .auth .btn{width:100%}.ir .auth-foot{text-align:center;margin-top:20px}.ir a{color:#00818b;text-decoration:underline}.ir .small{font-size:13px}\n.ir .tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.ir .dashboard-grid{display:grid;grid-template-columns:minmax(0,3fr) minmax(250px,1fr);gap:16px}.ir .right-stack{display:grid;gap:15px;align-content:start}\n.ir .meter-card{text-align:center;padding:17px 12px}.ir .meter-title{font-weight:700;text-align:left;font-size:16px}.ir .gauge-svg{width:100%;max-width:220px;margin:5px auto 0;display:block}.ir .meter-range{display:flex;justify-content:space-between;color:#6a7886;font-size:12px;margin:0 8px}.ir .status-line{display:flex;justify-content:space-between;align-items:center;margin:15px 0;gap:8px}.ir .pill{border-radius:8px;padding:5px 10px;background:#ecf0f3;font-weight:650;font-size:13px}.ir .pill.ok{background:#d8f2dd;color:#237c37}.ir .pill.blue{background:#d8eeff;color:#24598b}\n.ir .periods{display:flex;gap:8px;flex-wrap:wrap}.ir .periods .btn{font-size:14px;padding:9px 16px}.ir .chartframe{width:100%;display:block;margin-top:22px}.ir .chart-labels{display:flex;justify-content:space-between;margin:0 20px 0 48px;color:#526779;font-size:12px}\n.ir .controlrow{display:grid;grid-template-columns:220px minmax(150px,1fr) 105px;align-items:center;gap:22px;border-bottom:1px solid #edf0f3;padding:25px 0}.ir .controlrow:last-child{border-bottom:0}.ir input[type=range]{width:100%;accent-color:#008b92;cursor:pointer}.ir .savebar{text-align:center;padding-top:22px}\n@media(max-width:1050px){.ir .tiles{grid-template-columns:repeat(2,minmax(0,1fr))}.ir .dashboard-grid{grid-template-columns:1fr}}@media(max-width:620px){.ir .tiles{grid-template-columns:1fr}.ir .auth{padding:24px 16px}.ir .controlrow{grid-template-columns:1fr;gap:8px}.ir h1{font-size:25px}}\n\n</style>\n",
