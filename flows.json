        "head": "",
        "format": "<template>\n<div class=\"ir\">\n<div class=\"card auth\"><div class=\"auth-mark\">👤</div><h1>Đăng ký tài khoản</h1>\n<div class=\"field\"><label>Tên đăng nhập</label><input type=\"text\" v-model.trim=\"username\" placeholder=\"Nhập tên đăng nhập\" autocomplete=\"username\" /></div>\n<div class=\"field\"><label>Mật khẩu</label><input type=\"password\" v-model=\"password\" placeholder=\"Nhập mật khẩu\" autocomplete=\"new-password\" /></div>\n<div class=\"field\"><label>Nhập lại mật khẩu</label><input type=\"password\" v-model=\"confirm\" placeholder=\"Nhập lại mật khẩu\" autocomplete=\"new-password\" /></div>\n<button class=\"btn\" @click=\"register\">Đăng ký</button><div class=\"auth-foot\">Đã có tài khoản? <a href=\"/tuoi-cay/dang-nhap\">Đăng nhập</a></div>\n\n</div>\n</template>\n<script>\nexport default {\n  data(){return {username:'',password:'',confirm:'',notice:''}},\n  methods:{register(){if(!this.username||!this.password||!this.confirm){this.notice='Hãy nhập đủ các trường.';return;}if(this.password!==this.confirm){this.notice='Mật khẩu nhập lại không khớp.';return;}this.notice='Form hợp lệ (demo). Chưa lưu tài khoản vào JSON.';}}\n}\n</script>\n<style>\n\n.ir{font-family:Roboto,Arial,sans-serif;color:#16232d;max-width:1450px;margin:0 auto;padding:12px 8px 30px}\n.ir *{box-sizing:border-box}.ir h1{font-size:30px;font-weight:800;margin:4px 0 22px}.ir h2{font-size:20px;font-weight:750;margin:0 0 18px}.ir h3{font-size:17px;font-weight:700;margin:0 0 15px}\n.ir .muted{color:#6b7e8e}.ir .card{background:white;border:1px solid #e2e9ef;box-shadow:0 3px 12px #18364c14;border-radius:14px;padding:23px;min-width:0}\n.ir .btn{appearance:none;border:0;background:#00868e;color:white;font-size:16px;font-weight:700;border-radius:9px;padding:13px 23px;cursor:pointer;text-align:center}.ir .btn:hover{background:#006b75}.ir .btn:focus-visible{outline:3px solid #6acbd0;outline-offset:2px}\n.ir .outline{background:white;border:1px solid #cbd7df;color:#1d4856}.ir .outline.active{background:#00868e;color:white}\n.ir .note{padding:14px 17px;background:#e4f1ff;color:#1a5886;border-radius:9px;font-size:14px;margin-top:18px}\n.ir .headrow{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}\n.ir input[type=text], .ir input[type=password], .ir input[type=number], .ir input[type=date]{font:inherit;display:block;border:1px solid #becdd9;border-radius:9px;background:white;padding:11px 12px;min-width:0;width:100%;color:#172936}\n.ir label{font-weight:650}.ir .field{display:grid;gap:7px;margin:0 0 18px}.ir .auth{max-width:530px;margin:35px auto 10px;padding:35px 38px}.ir .auth h1{text-align:center;margin-top:12px}.ir .auth-mark{text-align:center;font-size:42px}.ir .auth .btn{width:100%}.ir .auth-foot{text-align:center;margin-top:20px}.ir a{color:#00818b;text-decoration:underline}.ir .small{font-size:13px}\n.ir .tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.ir .dashboard-grid{display:grid;grid-template-columns:minmax(0,3fr) minmax(250px,1fr);gap:16px}.ir .right-stack{display:grid;gap:15px;align-content:start}\n.ir .meter-card{text-align:center;padding:17px 12px}.ir .meter-title{font-weight:700;text-align:left;font-size:16px}.ir .gauge-svg{width:100%;max-width:220px;margin:5px auto 0;display:block}.ir .meter-range{display:flex;justify-content:space-between;color:#6a7886;font-size:12px;margin:0 8px}.ir .status-line{display:flex;justify-content:space-between;align-items:center;margin:15px 0;gap:8px}.ir .pill{border-radius:8px;padding:5px 10px;background:#ecf0f3;font-weight:650;font-size:13px}.ir .pill.ok{background:#d8f2dd;color:#237c37}.ir .pill.blue{background:#d8eeff;color:#24598b}\n.ir .periods{display:flex;gap:8px;flex-wrap:wrap}.ir .periods .btn{font-size:14px;padding:9px 16px}.ir .chartframe{width:100%;display:block;margin-top:22px}.ir .chart-labels{display:flex;justify-content:space-between;margin:0 20px 0 48px;color:#526779;font-size:12px}\n.ir .controlrow{display:grid